# Copy to .env.local and fill in. .env.local is git-ignored — never commit keys.
# The same variables must also be set in Vercel:
#   Project → Settings → Environment Variables

# ---------------------------------------------------------------
# Supabase — required
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Server-only. Bypasses row-level security — never expose to the browser,
# never prefix with NEXT_PUBLIC_. Needed later for Stripe webhooks.
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Signup protection — Cloudflare Turnstile
# ---------------------------------------------------------------
# Optional but strongly recommended. Without it the email signup form will
# accept anything a script posts at it, which is how 189 unverifiable
# accounts reached the waitlist in two weeks.
#
#   1. Cloudflare → Turnstile → add a site → copy the site key and secret
#   2. Supabase → Authentication → Attack Protection → CAPTCHA → choose
#      Turnstile and paste the SECRET there (it never goes in this file)
#   3. Put the SITE key below, and in Vercel
#
# Leave unset and the challenge simply doesn't render — nothing breaks.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------
# Lesson video hosting
# ---------------------------------------------------------------
# Leave unset locally: videos are served from public/videos/ (git-ignored).
# Set in Vercel once videos are uploaded to a host. No trailing slash.
# NEXT_PUBLIC_VIDEO_BASE_URL=https://your-host/lesson-videos

# ---------------------------------------------------------------
# Stripe (not yet wired up)
# ---------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------
# OpenAI — voice practice coach (not yet wired up)
# ---------------------------------------------------------------
# OPENAI_API_KEY=

# ---------------------------------------------------------------
# Admin insight agent
# ---------------------------------------------------------------
# Required for the Insights panel in the admin console.
# OPENAI_API_KEY=sk-...
# Optional — defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
